{
  "name": "hkfamilyfun-v2",
  "version": "1.0.0",
  "description": "HK Family Fun Platform - Complete Rebuild",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "check:cookie-consent": "node scripts/check-cookie-consent-contract.mjs && node scripts/test-cookie-choice-route.mjs && node scripts/test-cookie-persistence.mjs",
    "check:analytics-export": "node scripts/check-analytics-export-contract.mjs",
    "check:analytics-summary": "node scripts/test-analytics-summary.mjs",
    "check:admin-growth": "node scripts/test-admin-growth-dashboard.mjs",
    "check:commerce-copy": "node scripts/check-commerce-copy.mjs",
    "check:event-cards": "node scripts/check-event-card-contract.mjs",
    "check:today-timeline": "node scripts/test-today-timeline.mjs",
    "check:event-detail": "node scripts/check-event-detail-contract.mjs",
    "check:event-seo": "node scripts/check-event-seo-contract.mjs",
    "check:event-data": "node scripts/check-event-data-completeness.mjs",
    "check:event-calendar": "node scripts/check-event-calendar-timezone.mjs",
    "check:events-ssr": "node scripts/check-events-server-preload.mjs",
    "check:event-display": "node scripts/check-event-display-normalization.mjs",
    "check:advertising-orders": "node scripts/check-advertising-order-contract.mjs",
    "check:banner-preview": "node scripts/check-banner-preview-contract.mjs",
    "check:production-e2e": "node scripts/check-production-e2e-isolation.mjs",
    "check:launch-docs": "node scripts/check-launch-documentation.mjs",
    "check:production-smoke": "node scripts/check-production-smoke-contract.mjs && node scripts/check-production-smoke-concurrency.mjs",
    "check:migration-drift-lock": "node scripts/check-migration-drift-lock.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"docs/**/*.md\" \"README.md\"",
    "db:push": "node scripts/guard-db-push-until-migration-repair.mjs",
    "db:migration:list": "supabase migration list",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "check:calendar-persona": "node scripts/check-calendar-persona-contract.mjs",
    "check:merchant-preview": "node scripts/check-merchant-preview-contract.mjs",
    "check:approval-workflow": "node scripts/check-approval-workflow-contract.mjs",
    "check:event-mobile-content": "node scripts/check-event-mobile-content.mjs",
    "check:event-import": "node scripts/check-event-import-extractor.mjs",
    "check:home-card-readability": "node scripts/check-home-card-readability.mjs",
    "check:public-formatting": "node scripts/test-public-formatting.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "^5.32.1",
    "axios": "^1.20.0",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.48.0",
    "next": "16.4.2",
    "openai": "^6.46.0",
    "react": "19.2.0",
    "react-calendar": "6.0.1",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.51.3",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "5.0.0",
    "tailwind-merge": "^2.2.2",
    "typescript": "^5.4.4",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.29",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.11.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "autoprefixer": "^10.4.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1"
  }
}
