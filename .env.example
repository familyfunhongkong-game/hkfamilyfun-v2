# Supabase
# Copy values from the HK Family Fun V2 Supabase project settings.
# Never commit real keys or service-role credentials to Git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# App URLs
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Production cutover values belong in Vercel Production only:
# NEXT_PUBLIC_APP_URL=https://www.hkfamilyfun.com
# NEXT_PUBLIC_SITE_URL=https://www.hkfamilyfun.com
# SITE_URL=https://www.hkfamilyfun.com
# NEXT_PUBLIC_API_URL=https://www.hkfamilyfun.com/api
#
# Keep Preview values on the staging/Vercel host so preview Auth/callback
# flows do not point at the live production domain.

NODE_ENV=development

# Features
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_MERCHANT=true

# Transactional email (server-only)
RESEND_API_KEY=
APPROVAL_EMAIL=info@hkfamilyfun.com

# Google OAuth / Planner / Admin Data Hub (server-only where applicable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_ADMIN_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin/google-drive/callback
# Production:
# GOOGLE_ADMIN_DRIVE_REDIRECT_URI=https://www.hkfamilyfun.com/api/admin/google-drive/callback
#
# GOOGLE_REDIRECT_URI is optional for Planner Calendar. If omitted, the
# application derives /api/google-calendar/callback from the request origin.

# Optional unattended Google Sheets sync
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional Generative AI. Safe rule/template fallbacks work without this key.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional low-cost event translation (Azure Translator F0 supported)
# Keep these server-only. Never prefix with NEXT_PUBLIC_.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
