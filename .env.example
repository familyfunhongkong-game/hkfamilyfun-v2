# Supabase
# Copy values from the HK Family Fun Supabase project settings.
# Never commit real keys or service-role credentials to Git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side only. NEVER prefix with NEXT_PUBLIC_ and NEVER commit the real value.
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Features
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_MERCHANT=true
